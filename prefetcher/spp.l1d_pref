
#include "cache.h"

// Track the recent memory access pattern of each instruction
struct IPEntry {
    uint64_t ip = 0;
    uint64_t last_addr = 0;
    int64_t stride = 0;
    uint8_t confidence = 0;
    bool valid = false;
};

static IPEntry table[64];

void CACHE::l1d_prefetcher_initialize()
{
    for (auto &entry : table)
        entry = IPEntry();

    std::cout << "SPP initialized" << std::endl;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip,
                                   uint8_t cache_hit, uint8_t type,
                                   uint8_t critical_ip_flag)
{
    // Ignore prefetch requests
    if (type == PREFETCH)
        return;

    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;
    IPEntry &entry = table[ip % 64];

    // Initialize tracking for a new instruction
    if (!entry.valid || entry.ip != ip) {
        entry.ip = ip;
        entry.last_addr = cl_addr;
        entry.stride = 0;
        entry.confidence = 0;
        entry.valid = true;
        return;
    }

    // Calculate the stride between consecutive accesses
    int64_t stride = (int64_t)cl_addr - (int64_t)entry.last_addr;
    entry.last_addr = cl_addr;

    if (stride == 0)
        return;

    // Increase confidence when the stride repeats
    if (stride == entry.stride) {
        if (entry.confidence < 3)
            entry.confidence++;
    } else {
        entry.stride = stride;
        entry.confidence = 0;
    }

    // Prefetch the next cache line after detecting a repeated stride
    if (entry.confidence >= 1) {
        int64_t next_cl = (int64_t)cl_addr + stride;

        if (next_cl < 0)
            return;

        uint64_t pf_addr = (uint64_t)next_cl << LOG2_BLOCK_SIZE;

        // Do not prefetch across a 4 KB page boundary
        if ((pf_addr >> LOG2_PAGE_SIZE) == (addr >> LOG2_PAGE_SIZE))
            prefetch_line(ip, addr, pf_addr, FILL_L1, 0);
    }

    entry.stride = stride;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr,
                                      uint32_t set, uint32_t way,
                                      uint8_t prefetch,
                                      uint64_t v_evicted_addr,
                                      uint64_t evicted_addr,
                                      uint32_t metadata_in)
{
}

void CACHE::l1d_prefetcher_final_stats()
{
}
