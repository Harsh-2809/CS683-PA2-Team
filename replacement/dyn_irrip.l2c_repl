#include "cache.h"
#include <cstdlib>

// Task 3: Prefetch-aware dynamic I-RRIP for L2C
// Uses set dueling:
// - Leader sets run plain SRRIP to measure workload characteristics
// - Follower sets pick between I-RRIP and SRRIP using leader stats
// - Prefetch requests (from SPP) are filtered: inserted with max RRPV (3),
//   no promotion on prefetch hit, and evicted before demand data if unused.

#define maxRRPV 3

#define INSTR_INSERT_RRPV  1
#define DATA_INSERT_RRPV   2
#define INSTR_HIT_RRPV     0
#define DATA_HIT_RRPV      1
#define PF_INSERT_RRPV     3

// 32 leader sets across 1024 total L2 sets (1 out of every 32)
#define LEADER_GAP   32
#define EPOCH_LEN    256

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// leader set tracking
uint64_t ld_instr_acc = 0, ld_instr_miss = 0;
uint64_t ld_total_acc = 0, ld_total_miss = 0;
uint32_t epoch_events = 0;

bool use_irrip = false;
double irrip_threshold = 0.25;
bool pf_aware = true;

// stats counters
uint64_t epochs_irrip = 0;
uint64_t epochs_rrip = 0;
uint64_t mode_switches = 0;
uint64_t pf_fills = 0;
uint64_t pf_evicted_unused = 0;

static inline bool is_leader(uint32_t set)
{
    return (set % LEADER_GAP) == 0;
}

// ignore page table walk requests
static inline bool is_instr_line(uint32_t type, uint8_t isInstruction)
{
    return isInstruction && (type == LOAD || type == PREFETCH);
}

static inline bool set_uses_irrip(uint32_t set)
{
    if (is_leader(set))
        return false;
    return use_irrip;
}

static void end_epoch()
{
    double den = (double)(ld_total_acc + ld_total_miss);
    double score = (den > 0.0) ? (double)(ld_instr_acc + ld_instr_miss) / den : 0.0;

    bool new_mode = (score > irrip_threshold);
    if (new_mode != use_irrip)
        mode_switches++;
    use_irrip = new_mode;

    if (use_irrip)
        epochs_irrip++;
    else
        epochs_rrip++;

    // decay counters for phase responsiveness
    ld_instr_acc /= 2;
    ld_instr_miss /= 2;
    ld_total_acc /= 2;
    ld_total_miss /= 2;
    epoch_events = 0;
}

void CACHE::l2c_initialize_replacement()
{
    const char *env = getenv("IRRIP_THRESHOLD");
    if (env) {
        double t = atof(env);
        if (t > 0.0 && t < 1.0)
            irrip_threshold = t;
    }

    const char *pf = getenv("PF_AWARE");
    if (pf && atoi(pf) == 0)
        pf_aware = false;

    cout << "Initialize Dynamic I-RRIP state for L2C, threshold " << irrip_threshold
         << ", prefetch aware " << pf_aware << endl;

    for (int i = 0; i < L2C_SET; i++) {
        for (int j = 0; j < L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // pick invalid line first if available
    for (int i = 0; i < L2C_WAY; i++) {
        if (!current_set[i].valid)
            return i;
    }

    bool irrip = set_uses_irrip(set);

    while (1) {
        // priority 1: unused prefetched data lines at max RRPV
        if (pf_aware) {
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && current_set[i].prefetch && !current_set[i].instruction) {
                    pf_evicted_unused++;
                    return i;
                }
            }
        }

        // priority 2: regular data lines at max RRPV (if in I-RRIP mode)
        if (irrip) {
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction)
                    return i;
            }
        }

        // priority 3: any line at max RRPV
        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV)
                return i;
        }

        // aging step
        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    assert(0);
    return 0;
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    bool instr = is_instr_line(type, isInstruction);
    bool data_pf = (type == PREFETCH) && !instr;

    // track demand traffic in leader sets
    if (is_leader(set) && type != WRITEBACK && !(pf_aware && data_pf)) {
        ld_total_acc++;
        if (instr)
            ld_instr_acc++;

        if (!hit) {
            ld_total_miss++;
            if (instr)
                ld_instr_miss++;
        }

        if (++epoch_events >= EPOCH_LEN)
            end_epoch();
    }

    // prefetch handling: insert at RRPV 3, no update on hits
    if (pf_aware && data_pf) {
        if (hit)
            return;

        l2_rrpv[set][way] = PF_INSERT_RRPV;
        pf_fills++;
        return;
    }

    // fallback to SRRIP
    if (!set_uses_irrip(set)) {
        if (hit)
            l2_rrpv[set][way] = 0;
        else
            l2_rrpv[set][way] = maxRRPV - 1;
        return;
    }

    // I-RRIP mode
    if (hit) {
        if (type == WRITEBACK)
            return;

        l2_rrpv[set][way] = instr ? INSTR_HIT_RRPV : DATA_HIT_RRPV;
        return;
    }

    l2_rrpv[set][way] = instr ? INSTR_INSERT_RRPV : DATA_INSERT_RRPV;
}

void CACHE::l2c_replacement_final_stats()
{
    cout << "Dyn I-RRIP threshold: " << irrip_threshold << "  prefetch aware: " << pf_aware << endl;
    cout << "Dyn I-RRIP epochs in I-RRIP mode: " << epochs_irrip
         << "  in SRRIP mode: " << epochs_rrip
         << "  switches: " << mode_switches << endl;
    cout << "Dyn I-RRIP prefetch fills: " << pf_fills
         << "  unused prefetches evicted first: " << pf_evicted_unused << endl;
}